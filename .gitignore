.ruff_cache/

# Node (if any frontend build)
node_modules/
.next/
dist/
npm-debug.log*

# Design files
*.psd
*.sketch
*.fig
*.xd

# Model artifacts (large — exclude raw, keep small ONNX)
*.h5
*.pt
*.pth
*.ckpt
*.pb
*.savedmodel/
# XGBoost raw model can be large; commit only if < 2MB
xgboost_model.pkl

# Keep committed artifacts (small, no secrets)
!ml_artifacts/*.onnx
!ml_artifacts/*.pkl
!ml_artifacts/*.json
!ml_artifacts/*.txt

# Docker
.dockerignore
docker-compose.override.yml

# Render / Infrastructure
render.env
