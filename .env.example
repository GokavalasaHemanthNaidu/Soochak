# GROQ API KEY — Get yours free at https://groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Demo API key for public endpoints (not user auth)
DEMO_API_KEY=roadrisk-demo-2024

# Model version being served
MODEL_VERSION=v1.0.0

# SQLite database file path (directory mounted in Docker)
DB_PATH=./data/roadrisk.db

# Rate limiting: max requests per minute per IP
RATE_LIMIT_RPM=30

# Maximum incidents per batch request
MAX_BATCH_SIZE=1000
